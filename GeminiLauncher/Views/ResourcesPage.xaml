                                </ItemsControl>

                                <!-- INSTALLED MODS SECTION -->
                                <TextBlock Text="已安装的Mod" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,12"/>

                                <Border Visibility="{Binding InstalledMods.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        Background="{StaticResource GlassLightBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="24,16">
                                    <TextBlock Text="暂无已安装的Mod" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding InstalledMods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource GlassLightBrush}" CornerRadius="8" Margin="0,0,0,6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Command="{Binding DataContext.RemoveInstalledModCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Padding="6,4">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <ui:SymbolIcon Symbol="Delete20" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#20FF4444"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- PREVIEW PANEL -->
                            <Border Grid.Column="1" Background="#14141E" CornerRadius="{StaticResource RadiusMedium}" Padding="12"
                                    Visibility="{Binding SelectedLocalMod, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Image48" FontSize="48" Foreground="{StaticResource GlassHeavyBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="预览区域" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="选择文件查看预览" FontSize="10" Foreground="{StaticResource GlassHeavyBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#14141E" CornerRadius="{StaticResource RadiusMedium}" Padding="12"
                                    Visibility="{Binding SelectedLocalMod, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Border CornerRadius="8" ClipToBounds="True" Height="120" Margin="0,0,0,12">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding SelectedLocalMod.PreviewImage}" Stretch="UniformToFill"/>
                                        </Border.Background>
                                        <Border Background="#30000000"/>
                                    </Border>
                                    <TextBlock Text="{Binding SelectedLocalMod.FileName}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedLocalMod.FileSizeDisplay}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- FOOTER -->
                    <Border Grid.Row="2" Margin="16,12,16,16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding ApplyLocalModsCommand}"
                                    Style="{StaticResource iOS26.CapsuleButton}"
                                    Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource AccentBrush}"
                                    Height="42" FontSize="14" FontWeight="SemiBold"
                                    Padding="24,0" MinWidth="140"
                                    Content="✅ 确认安装"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
