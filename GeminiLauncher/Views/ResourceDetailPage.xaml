<Page x:Class="GeminiLauncher.Views.ResourceDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:GeminiLauncher.ViewModels"
      xmlns:conv="clr-namespace:GeminiLauncher.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="900"
      Title="ResourceDetail"
      Background="Transparent">

    <Page.DataContext>
        <vm:ResourceDetailViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter"/>
        <conv:ProgressBarWidthConverter x:Key="ProgressBarWidthConverter"/>
        <conv:SelectedVersionConverter x:Key="SelectedVersionConverter"/>
        <conv:SelectedVersionBorderConverter x:Key="SelectedVersionBorderConverter"/>
        <conv:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="15" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassLightBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="VersionItem" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassLightBrush}"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource GlassLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource GlassStrongBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding SelectedVersion, Source={StaticResource ResourceKey}, FallbackValue={x:Null}}" Value="{x:Null}">
                    <!-- Default state -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusMedium}" Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00C853"/>
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassStrongBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource GlassMediumBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel Margin="28,24,28,40">

                <!-- HEADER -->
                <Grid Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Width="36" Height="36" Padding="0"
                                Click="Back_Click" ToolTip="返回">
                            <TextBlock Text="←" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="资源详情" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource GlassBorderBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,4" Margin="12,0,0,0"
                                Visibility="{Binding Resource.Type, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Resource.Type}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Height="34" Padding="16,0"
                                Click="OpenBrowser_Click" ToolTip="在浏览器中打开">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="打开网页" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- LOADING STATE -->
                <Border CornerRadius="{StaticResource RadiusLarge}" Background="#1C1C26" Padding="60,80"
                        Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48"
                                         Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="正在加载项目详情..." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- MAIN CONTENT -->
                <Grid Visibility="{Binding IsLoadingDetails, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HERO SECTION -->
                    <Border Grid.Row="0" Background="#1C1C26" CornerRadius="{StaticResource RadiusLarge}" Padding="28,24"
                            BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1" Margin="0,0,0,16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon & Info -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Width="72" Height="72" CornerRadius="{StaticResource RadiusLarge}" Background="{StaticResource GlassBorderBrush}"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Resource.IconImage}"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" MaxWidth="400">
                                    <TextBlock Text="{Binding Resource.Name}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="by " FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding Resource.Author}" FontSize="13"
                                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Resource.Summary}" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="380" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Stats -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                                <Border Style="{StaticResource StatCard}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇️" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Resource.DownloadsFormatted}"
                                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="下载量" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" FontSize="16" VerticalAlignment="Center"/>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Resource.FollowersFormatted}"
                                                       FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="关注者" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DESCRIPTION & META -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Description -->
                        <Border Grid.Column="0" Background="#1C1C26" CornerRadius="{StaticResource RadiusLarge}" Padding="24,20"
                                BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="📋 描述" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                              Template="{DynamicResource GlassScrollViewer}">
                                    <TextBlock Text="{Binding Resource.Description}" FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>

                                <!-- Tags / Categories -->
                                <ItemsControl ItemsSource="{Binding Resource.Categories}" Margin="0,16,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource GlassMediumBrush}" CornerRadius="{StaticResource RadiusSmall}"
                                                    Padding="10,5" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Right: Meta Info -->
                        <Border Grid.Column="1" Background="#1C1C26" CornerRadius="{StaticResource RadiusLarge}" Padding="20,18"
                                BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ℹ️ 信息" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                                <!-- License -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="许可证" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                               Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Resource.License}" FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"
                                               Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Platform -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="平台" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                               Grid.Column="0" VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource AccentGlassLightBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,3"
                                            Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Resource.Platform}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" FontWeight="Medium"/>
                                    </Border>
                                </Grid>

                                <!-- Side Type -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="运行环境" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                               Grid.Column="0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="{StaticResource AccentGlassLightBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="7,3"
                                                Visibility="{Binding Resource.IsClientSideOnly, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="客户端" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Border Background="#182196F3" CornerRadius="6" Padding="7,3"
                                                Margin="4,0,0,0"
                                                Visibility="{Binding Resource.IsServerSideOnly, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="服务端" FontSize="10" Foreground="#2196F3"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Created/Updated -->
                                <Separator Background="{StaticResource GlassLightBrush}" Margin="0,8,0,12"/>
                                <TextBlock Text="创建时间" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="{Binding Resource.DateCreated, StringFormat='yyyy-MM-dd'}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="更新时间" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Resource.DateModified, StringFormat='yyyy-MM-dd'}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VERSION SELECTION & DOWNLOAD -->
                    <Border Grid.Row="2" Background="#1C1C26" CornerRadius="{StaticResource RadiusLarge}" Padding="24,22"
                            BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1" Margin="0,0,0,16">

                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="📦 版本选择" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Loader Filter -->
                                    <ComboBox ItemsSource="{Binding LoaderOptions}"
                                              SelectedItem="{Binding SelectedLoaderFilter}"
                                              Width="110" Height="32" FontSize="12"
                                              Style="{StaticResource iOS26.GlassComboBox}"/>
                                    <!-- Sort -->
                                    <ComboBox ItemsSource="{Binding VersionSortOptions}"
                                              SelectedItem="{Binding SelectedVersionSort}"
                                              Width="100" Height="32" FontSize="12"
                                              Margin="8,0,0,0"
                                              Style="{StaticResource iOS26.GlassComboBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Version List -->
                            <Border MaxHeight="260" ClipToBounds="True">
                                <ListBox ItemsSource="{Binding FilteredVersions}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource GlassLightBrush}" CornerRadius="{StaticResource RadiusMedium}"
                                                    BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1"
                                                    Cursor="Hand" Padding="14,10" Margin="0,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#25FFD700"/>
                                                                <Setter Property="BorderBrush" Value="#50FFD700"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource GlassLightBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding ReleaseDate}"
                                                                       FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                                            <TextBlock Text="  |  " FontSize="10" Foreground="{StaticResource GlassHeavyBrush}"/>
                                                            <TextBlock Text="{Binding Size, StringFormat='{}{0:F1} MB'}"
                                                                       FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18"
                                                                     Foreground="{StaticResource AccentBrush}"
                                                                     Grid.Column="1" VerticalAlignment="Center"
                                                                     Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectVersionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Text="没有找到匹配的版本" FontSize="13" Foreground="{StaticResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,30,0,0"
                                       Visibility="{Binding FilteredVersions.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        </StackPanel>
                    </Border>

                    <!-- DOWNLOAD SECTION -->
                    <Border Grid.Row="3" Background="#1C1C26" CornerRadius="{StaticResource RadiusLarge}" Padding="24,22"
                            BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="⚡ 下载安装" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="目标路径: "/>
                                    <Run Text="{Binding InstallPathDisplay}" Foreground="{StaticResource TextTertiaryBrush}"/>
                                </TextBlock>

                                <TextBlock FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0">
                                    <Run Text="游戏版本: "/>
                                    <Run Text="{Binding TargetGameVersion, FallbackValue=未选择}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        MinWidth="200">

                                <!-- Version Selection Dropdown -->
                                <ComboBox ItemsSource="{Binding FilteredVersions}"
                                          SelectedItem="{Binding SelectedVersionItem, Mode=TwoWay}"
                                          Style="{StaticResource iOS26.GlassComboBox}"
                                          Height="36" Margin="0,0,0,10" FontSize="12"
                                          IsEnabled="{Binding IsVersionsLoading, Converter={StaticResource InverseBoolToVis}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}" MaxWidth="180"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" " FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value=""/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GameVersions.Count}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Not Downloading State -->
                                <Grid Visibility="{Binding Resource.IsDownloading, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Button Command="{Binding StartDownloadCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Height="42" Padding="28,0" Margin="0,0,0,8"
                                            IsEnabled="{Binding Resource.SelectedVersion, Converter={StaticResource NullToBoolConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⬇" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="开始下载" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <CheckBox Content="同时下载依赖项" IsChecked="{Binding DownloadDependencies}"
                                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                              Grid.Row="1" HorizontalAlignment="Center"/>
                                </Grid>

                                <!-- Download Enqueued State -->
                                <Grid Visibility="{Binding ShowDownloadProgressButton, Converter={StaticResource BoolToVis}}"
                                      VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Command="{Binding NavigateToDownloadManagerCommand}"
                                            Style="{StaticResource ModernButton}"
                                            Height="42" Padding="24,0"
                                            Background="{StaticResource AccentGlassLightBrush}" Foreground="{StaticResource AccentBrush}">
                                        <Border Background="#0A00E676" CornerRadius="{StaticResource RadiusSmall}" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📥" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="下载进度" FontSize="14" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DEPENDENCIES PANEL (Collapsible) -->
                    <Border Background="#1C1C26" CornerRadius="{StaticResource RadiusLarge}" Padding="22,18"
                            BorderBrush="{StaticResource GlassLightBrush}" BorderThickness="1" Margin="16,0,0,0"
                            Visibility="{Binding ShowDependenciesPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="🔗 依赖项" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding DependencyList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GlassLightBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FileName}" FontSize="12"
                                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding DependencyType}" FontSize="10"
                                                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Background="{StaticResource AccentGlassLightBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,3"
                                                        Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="必需" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
