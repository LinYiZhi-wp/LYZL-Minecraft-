<Page x:Class="GeminiLauncher.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:GeminiLauncher.Views"
      xmlns:vm="clr-namespace:GeminiLauncher.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Home"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,0">
            <Grid Margin="24,24,16,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="GreetingText" Text="👋 你好，Player"
                               FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="准备好开始冒险了吗？" FontSize="14" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        CornerRadius="{StaticResource RadiusPill}"
                        Background="{StaticResource iOS26.FloatingLayer}"
                        BorderBrush="{StaticResource GlassBorderBrush}"
                        BorderThickness="1"
                        Padding="14,8"
                        Cursor="Hand"
                        MouseLeftButtonDown="AccountCapsule_Click"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="AccountScale"/>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00E676" Offset="0"/>
                                    <GradientStop Color="#00C853" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="PlayerNameText" Text="Player" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="PlayerModeText" Text="离线模式" FontSize="10" Opacity="0.5" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="▼" FontSize="9" VerticalAlignment="Center" Foreground="White" Opacity="0.5"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource iOS26.GlassCard}" Margin="0,0,0,24" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionHeroText" Text="LYZL"
                                   FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="CurrentVersionSubtitle"
                                   Text="{DynamicResource Home_NoVersionSelected}"
                                   FontSize="14" Foreground="#B0FFFFFF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button x:Name="LaunchButton"
                                Command="{Binding LaunchGameCommand}"
                                Content="🚀 启动游戏"
                                Height="52" FontSize="18" FontWeight="Bold"
                                Foreground="White" Cursor="Hand" Margin="0,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Height="{TemplateBinding Height}" CornerRadius="{StaticResource RadiusPill}" RenderTransformOrigin="0.5,0.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#2ECC71" Offset="0"/>
                                                            <GradientStop Color="#00E676" Offset="0.5"/>
                                                            <GradientStop Color="#00C853" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="ButtonScale"/>
                                                    </Border.RenderTransform>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#5CFF9A" Offset="0"/>
                                                                    <GradientStop Color="#00FF80" Offset="0.5"/>
                                                                    <GradientStop Color="#00E676" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Button.Visibility>
                                <Binding Path="IsLaunching" Converter="{StaticResource InverseBooleanToVisibilityConverter}"/>
                            </Button.Visibility>
                        </Button>

                        <Border x:Name="LaunchProgressPanel" CornerRadius="{StaticResource RadiusPill}" Height="56" Margin="0,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Visibility>
                                <Binding Path="IsLaunching" Converter="{StaticResource BooleanToVisibilityConverter}"/>
                            </Border.Visibility>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RunningScale"/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A2E28" Offset="0"/>
                                    <GradientStop Color="#111D18" Offset="0.5"/>
                                    <GradientStop Color="#1A2E28" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2800E676" Offset="0"/>
                                    <GradientStop Color="#1800C853" Offset="0.5"/>
                                    <GradientStop Color="#2800E676" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="14,0,10,0" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="PulseIcon"/>
                                    </Grid.RenderTransform>

                                    <Ellipse x:Name="GlowRing" Width="42" Height="42"
                                             Fill="Transparent" StrokeThickness="2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Stroke>
                                            <SolidColorBrush x:Name="GlowRingBrush" Color="#2000E676"/>
                                        </Ellipse.Stroke>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                       From="34" To="46" Duration="0:0:1.5"
                                                                       AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                       From="34" To="46" Duration="0:0:1.5"
                                                                       AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <ColorAnimation Storyboard.TargetName="GlowRingBrush"
                                                                        Storyboard.TargetProperty="Color"
                                                                        From="#3000E676" To="#0800E676"
                                                                        Duration="0:0:1.5" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>

                                    <Border Width="36" Height="36" CornerRadius="18"
                                            Background="#1500E676" BorderBrush="#2500E676"
                                            BorderThickness="1.5"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎮" FontSize="17" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform x:Name="IconBounce"/>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="IconBounce"
                                                                           Storyboard.TargetProperty="ScaleX"
                                                                           From="1.0" To="1.08" Duration="0:0:0.9"
                                                                           AutoReverse="True">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetName="IconBounce"
                                                                           Storyboard.TargetProperty="ScaleY"
                                                                           From="1.0" To="1.08" Duration="0:0:0.9"
                                                                           AutoReverse="True">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                    </Border>

                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Grid.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="PulseIcon"
                                                                   Storyboard.TargetProperty="ScaleX"
                                                                   From="1.0" To="1.06" Duration="0:0:1.8"
                                                                   AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="PulseIcon"
                                                                   Storyboard.TargetProperty="ScaleY"
                                                                   From="1.0" To="1.06" Duration="0:0:1.8"
                                                                   AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="LaunchStatusText" Text="{Binding StatusMessage}"
                                                   Foreground="White" FontSize="14" FontWeight="SemiBold"/>

                                        <TextBlock FontSize="13" Foreground="#00E676" FontWeight="SemiBold"
                                                   Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                   x:Name="StatusDots">
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                           From="0.5" To="1.0" Duration="0:0:0.8"
                                                                           AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                            <TextBlock.Text>
                                                <Binding ElementName="LaunchStatusText" Path="Text"
                                                         StringFormat="{}{0}..."/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border CornerRadius="3" Height="4" Margin="0,7,0,0"
                                            ClipToBounds="True" Width="170" HorizontalAlignment="Left"
                                            Background="#12000000">

                                        <Grid ClipToBounds="True">
                                            <Rectangle RadiusX="3" RadiusY="3"
                                                       Fill="#00E676"
                                                       HorizontalAlignment="Left" Width="50"
                                                       Opacity="0.85">
                                                <Rectangle.RenderTransform>
                                                    <TranslateTransform x:Name="ShimmerBar"/>
                                                </Rectangle.RenderTransform>
                                                <Rectangle.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="ShimmerBar"
                                                                               Storyboard.TargetProperty="X"
                                                                               From="-60" To="190"
                                                                               Duration="0:0:1.6">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseIn"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <ColorAnimation Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                                From="#00FF88" To="#00C853"
                                                                                Duration="0:0:1.6"
                                                                                AutoReverse="False"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Rectangle.Triggers>
                                            </Rectangle>

                                            <Rectangle RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Left" Width="50"
                                                       IsHitTestVisible="False">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                                <Rectangle.RenderTransform>
                                                    <TranslateTransform x:Name="ShimmerHighlight"/>
                                                </Rectangle.RenderTransform>
                                                <Rectangle.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="ShimmerHighlight"
                                                                               Storyboard.TargetProperty="X"
                                                                               From="-100" To="220"
                                                                               Duration="0:0:2.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Rectangle.Triggers>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="{StaticResource RadiusMedium}"
                                        Background="#1500E676" BorderBrush="#2500E676"
                                        BorderThickness="1" Padding="14,6"
                                        Margin="0,0,16,0" Cursor="Hand"
                                        VerticalAlignment="Center"
                                        MouseLeftButtonDown="CancelLaunch_Click">
                                    <TextBlock Text="取消" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#90FFFFFF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                            To="#2500E676" Duration="0:0:0.15"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                            To="#4000E676" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                            To="#1500E676" Duration="0:0:0.2"/>
                                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                            To="#2500E676" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RunningScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           From="0.92" To="1.0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RunningScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           From="0.92" To="1.0" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{DynamicResource Home_SelectVersion}" Style="{StaticResource iOS26.CapsuleButton}" Click="OpenVersionSelector_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource Home_VersionSettings}" Style="{StaticResource iOS26.CapsuleButton}" Click="OpenVersionSettings_Click" Margin="0,0,8,0"/>
                        <Button Content="🧩" Height="40" Width="46" Click="OpenModManager_Click" ToolTip="{DynamicResource Home_ModManagerTooltip}" Style="{StaticResource iOS26.CapsuleButton}" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2" Text="快速概览" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>

            <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource iOS26.GlassCard}" Margin="0,0,8,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="22" Margin="0,0,0,6"/>
                        <TextBlock x:Name="VersionCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="已安装版本" FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource iOS26.GlassCard}" Margin="8,0,8,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="☕" FontSize="22" Margin="0,0,0,6"/>
                        <TextBlock x:Name="JavaStatusText" Text="未检测" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="Java 运行时" FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource iOS26.GlassCard}" Margin="8,0,8,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="🧩" FontSize="22" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ModCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="已安装 Mod" FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource iOS26.GlassCard}" Margin="8,0,0,0" Padding="16,14" Cursor="Hand" MouseLeftButtonDown="OpenLogFolder_Click">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="22" Margin="0,0,0,6"/>
                        <TextBlock Text="查看日志" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="点击打开" FontSize="11" Foreground="#80FFFFFF" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource iOS26.GlassCard}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="⚡ 快速操作" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                        <Button Content="📂 打开游戏目录" Click="OpenGameDir_Click" Style="{StaticResource iOS26.CapsuleButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" HorizontalContentAlignment="Center"/>
                        <Button Content="📂 打开 Mods 文件夹" Click="OpenModsDir_Click" Style="{StaticResource iOS26.CapsuleButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" HorizontalContentAlignment="Center"/>
                        <Button Content="📋 打开日志文件" Click="OpenLogFolder_Click" Style="{StaticResource iOS26.CapsuleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource iOS26.GlassCard}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="🎮 版本列表" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                        <ListBox x:Name="VersionListBox" Background="Transparent" BorderThickness="0" MaxHeight="180"
                                 SelectionChanged="VersionListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🧊" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#80FFFFFF"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusSmall}" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>