<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== UNIFIED COLOR PALETTE ========== -->
    <!-- Accent Green -->
    <Color x:Key="AccentColor">#00E676</Color>
    <Color x:Key="AccentHoverColor">#00FF80</Color>
    <Color x:Key="AccentDimColor">#00C853</Color>
    <Color x:Key="AccentLightColor">#69F0AE</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

    <!-- System Accent (for WPF-UI compatibility) -->
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource AccentDimColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource AccentLightColor}"/>

    <!-- Text Hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#60FFFFFF"/>

    <!-- Glass Surface Hierarchy -->
    <SolidColorBrush x:Key="GlassLightBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="GlassMediumBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="GlassHeavyBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorderHoverBrush" Color="#35FFFFFF"/>

    <!-- Surface Layers -->
    <SolidColorBrush x:Key="SurfaceContentBrush" Color="#C01A1A22"/>
    <SolidColorBrush x:Key="SurfaceFloatingBrush" Color="#B0202028"/>
    <SolidColorBrush x:Key="SurfaceInputBrush" Color="#35202028"/>
    <SolidColorBrush x:Key="SurfaceDropdownBrush" Color="#E01C1C24"/>

    <!-- Accent Tinted Glass -->
    <SolidColorBrush x:Key="AccentGlassLightBrush" Color="#1500E676"/>
    <SolidColorBrush x:Key="AccentGlassMediumBrush" Color="#2000E676"/>
    <SolidColorBrush x:Key="AccentGlassStrongBrush" Color="#2500E676"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#3000E676"/>

    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC107"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#00E676"/>

    <!-- ========== UNIFIED CORNER RADIUS ========== -->
    <CornerRadius x:Key="RadiusXLarge">24</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">22</CornerRadius>
    <CornerRadius x:Key="RadiusCard">36</CornerRadius>

</ResourceDictionary>